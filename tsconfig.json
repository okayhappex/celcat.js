{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ESNext", "DOM"],

		"rootDir": "./src",
		"outDir": "./lib",

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "lib"]
}
